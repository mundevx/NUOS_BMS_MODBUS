# NUOS BMS - ESP32-C6 Modbus board

# ---------------------------------------------------------------------------
# CRITICAL: free UART0 for the link to the ESP32-H2.
# The console moves to USB-Serial-JTAG, so ESP_LOG output no longer collides
# with the frames on UART0. Flash and monitor over the USB port.
# ---------------------------------------------------------------------------
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 1 ms tick keeps the 10 ms inter-endpoint delay honest.
CONFIG_FREERTOS_HZ=1000

# The Modbus task blocks on UART reads for up to 1 s per endpoint.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
